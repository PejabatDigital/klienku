{
  "$schema": "node_modules/wrangler/config-schema.json",

  // The "klienku" Worker, deployed by Workers Builds whenever main changes.
  "name": "klienku",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-12",

  // Reminders: every 5 minutes, send what's due (worker/reminders.js).
  "triggers": { "crons": ["*/5 * * * *"] },

  // klienku.kasahkod.cc is created and pointed here on deploy (kasahkod.cc is on this account).
  "routes": [
    { "pattern": "klienku.kasahkod.cc", "custom_domain": true }
  ],

  // `wrangler deploy` (and `wrangler dev`) builds the app first, so Workers Builds needs
  // no separate build command.
  "build": { "command": "npm run build" },

  // The built app (npm run build → dist/). Only /api/* runs Worker code; everything else
  // is served straight from assets, and unknown paths fall back to index.html.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Secrets, set with `npx wrangler secret put <NAME>` (or .dev.vars locally), never here:
  // VAPID_PRIVATE_KEY (Web Push), BETTER_AUTH_SECRET (sign-in), RESEND_API_KEY (emails).
  // OPEN_SIGNUP "false": only the first account can be created (Amin's).
  "vars": {
    "BETTER_AUTH_URL": "https://klienku.kasahkod.cc",
    "OPEN_SIGNUP": "false",
    "VAPID_PUBLIC_KEY": "BAlKmwJF13HZZEfeKagylXKmbU0U8aAQ64VwaeigruUz_LmwdTdTPTf7BSblqPrwiDw-SLNEjRzd_jZvJIQqpY4",
    "VAPID_SUBJECT": "mailto:hello@kasahkod.cc"
  },

  "d1_databases": [
    { "binding": "DB", "database_name": "klienku-production", "database_id": "ac7d55a7-3cc4-4634-9e79-8efb85157b2b", "migrations_dir": "migrations" }
  ]
}
